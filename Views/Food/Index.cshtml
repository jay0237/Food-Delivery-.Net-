@model FoodOrderingSystem.Models.MenuViewModel

@{
    ViewData["Title"] = "Explore menu";
    var fallbackImage = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=85";
}

<section class="menu-page-heading">
    <div>
        <p class="eyebrow">Freshly prepared for you</p>
        <h1>Explore our menu</h1>
    </div>
    <form asp-action="Explore" method="get" class="compact-search">
        <input type="hidden" name="categoryId" value="@Model.CategoryId" />
        <input type="hidden" name="minPrice" value="@Model.MinPrice" />
        <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
        <input type="hidden" name="availableOnly" value="@Model.AvailableOnly.ToString().ToLowerInvariant()" />
        <input name="search" value="@Model.Search" placeholder="Search food" aria-label="Search food" />
        <button type="submit" aria-label="Search">&#9906;</button>
    </form>
</section>

<form asp-action="Explore" method="get" class="row g-2 align-items-end mb-4">
    <input type="hidden" name="search" value="@Model.Search" />
    <div class="col-md-3">
        <label for="categoryId" class="form-label">Category</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">
                    @category.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="minPrice" class="form-label">Min price</label>
        <input id="minPrice" name="minPrice" value="@Model.MinPrice" type="number" min="0" step="0.01" class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="maxPrice" class="form-label">Max price</label>
        <input id="maxPrice" name="maxPrice" value="@Model.MaxPrice" type="number" min="0" step="0.01" class="form-control" />
    </div>
    <div class="col-md-3 form-check ms-2">
        <input id="availableOnly" name="availableOnly" value="true" type="checkbox" class="form-check-input" checked="@Model.AvailableOnly" />
        <input type="hidden" name="availableOnly" value="false" />
        <label for="availableOnly" class="form-check-label">Show available only</label>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<div class="menu-admin-tools">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="SearchExternalMenu" class="text-link">Import from OpenMenu</a>
        <a asp-action="Create" class="text-link">+ Add food</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Foods.Any())
{
    <div class="empty-menu">
        <h2>No dishes found</h2>
        <p>Try a different search.</p>
        <a class="add-button" asp-action="Explore">Show all dishes</a>
    </div>
}
else
{
    <div class="reference-food-grid">
        @foreach (var food in Model.Foods)
        {
            var category = food.Category?.Name ?? "Chef's special";
            var image = string.IsNullOrWhiteSpace(food.ImageUrl) ? fallbackImage : food.ImageUrl;
            <article class="reference-food-card">
                <a asp-action="Details" asp-route-id="@food.Id" class="reference-image-link">
                    <div class="reference-food-image" style="background-image:url('@image')">
                        <span class="food-category">@category</span>
                        <span class="favorite-button" aria-label="Save @food.Name">&#9825;</span>
                    </div>
                </a>
                <div class="reference-food-content">
                    <div class="reference-food-title-row">
                        <h2><a asp-action="Details" asp-route-id="@food.Id">@food.Name</a></h2>
                    </div>
                    <p class="reference-food-description">@food.Description</p>
                    <a asp-action="Details" asp-route-id="@food.Id" class="text-link">View details <span>&rarr;</span></a>
                    <div class="reference-food-footer">
                        <strong>₹@food.Price.ToString("0.00")</strong>
                        @if (food.IsAvailable)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="foodId" value="@food.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button class="reference-add-button" type="submit"><span aria-hidden="true">&#128722;</span> Add</button>
                            </form>
                        }
                        else
                        {
                            <span class="reference-unavailable">Unavailable</span>
                        }
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mt-2">
                            <a asp-action="Edit" asp-route-id="@food.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@food.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}
