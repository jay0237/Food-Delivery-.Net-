@model IEnumerable<FoodOrderingSystem.Models.Entities.Food>

@{
    ViewData["Title"] = "Food Menu";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Food Menu</h1>

        <div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-outline-primary me-2">
                    🛒 My Cart
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Food
                </a>
            }
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No food items found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var food in Model)
                {
                    <tr>

                        <td>
                            @food.Id
                        </td>

                        <td>
                            <strong>
                                @food.Name
                            </strong>

                            <br />

                            <small class="text-muted">
                                @food.Description
                            </small>
                        </td>

                        <td>
                            @(food.Category?.Name ?? "Uncategorized")
                        </td>

                        <td>
                            ₹@food.Price
                        </td>

                        <td>
                            @if (food.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Unavailable
                                </span>
                            }
                        </td>

                        <td>

                            @if (food.IsAvailable)
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="foodId"
                                           value="@food.Id" />

                                    <input type="hidden"
                                           name="quantity"
                                           value="1" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        🛒 Add
                                    </button>

                                </form>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@food.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@food.Id"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>