@model IEnumerable<FoodOrderingSystem.Models.DTOs.OpenMenu.OpenMenuItemDto>

@{
    ViewData["Title"] = "Search External Menu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>OpenMenu importer</h1>
            <p class="text-muted mb-0">Find external menu items and add them to your local menu.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to food menu</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form method="get" asp-controller="Food" asp-action="SearchExternalMenu" class="card p-4 shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="search" class="form-label">Search Term</label>
                <input type="text" id="search" name="search" class="form-control" value="@Context.Request.Query["search"]" placeholder="e.g. shrimp" required />
            </div>
            <div class="col-md-3">
                <label for="postalCode" class="form-label">Postal Code</label>
                <input type="text" id="postalCode" name="postalCode" class="form-control" value="@Context.Request.Query["postalCode"]" placeholder="e.g. 29204" required />
            </div>
            <div class="col-md-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" id="country" name="country" class="form-control" value="@Context.Request.Query["country"]" placeholder="e.g. US" required />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Menu Item Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Restaurant</th>
                        <th>Cuisine</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="width: 120px;">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.MenuItemName" class="img-thumbnail" style="max-width:100px; height:auto;" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>
                            <td class="fw-bold">@(string.IsNullOrWhiteSpace(item.MenuItemName) ? "Unnamed item" : item.MenuItemName)</td>
                            <td><small>@(string.IsNullOrWhiteSpace(item.MenuItemDescription) ? "No description" : item.MenuItemDescription)</small></td>
                            <td>
                                @if (item.MenuItemPrice.HasValue)
                                {
                                    <span class="badge bg-success">@item.MenuItemPrice.Value.ToString("C")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Price unavailable</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.RestaurantName) ? "Unknown restaurant" : item.RestaurantName)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CuisineTypePrimary))
                                {
                                    <span class="badge bg-info text-dark">@item.CuisineTypePrimary</span>
                                }
                                else { <span class="text-muted">Not provided</span> }
                            </td>
                            <td>
                                <small>
                                    @(item.Address1 ?? "")<br />
                                    @string.Join(", ", new[] { item.CityTown, item.StateProvince }.Where(value => !string.IsNullOrWhiteSpace(value)))<br />
                                    @(item.Country ?? "Location not provided")
                                </small>
                            </td>
                            <td style="min-width: 230px;">
                                <form asp-controller="Food" asp-action="ImportExternalFood" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="item.MenuItemName" value="@item.MenuItemName" />
                                    <input type="hidden" name="item.MenuItemDescription" value="@item.MenuItemDescription" />
                                    <input type="hidden" name="item.MenuItemPrice" value="@item.MenuItemPrice" />
                                    <input type="hidden" name="item.ImageUrl" value="@item.ImageUrl" />
                                    <input type="hidden" name="item.RestaurantName" value="@item.RestaurantName" />
                                    <input type="hidden" name="item.CuisineTypePrimary" value="@item.CuisineTypePrimary" />
                                    <input type="hidden" name="item.Address1" value="@item.Address1" />
                                    <input type="hidden" name="item.CityTown" value="@item.CityTown" />
                                    <input type="hidden" name="item.StateProvince" value="@item.StateProvince" />
                                    <input type="hidden" name="item.Country" value="@item.Country" />
                                    <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
                                    <input type="hidden" name="postalCode" value="@Context.Request.Query["postalCode"]" />
                                    <input type="hidden" name="country" value="@Context.Request.Query["country"]" />
                                    <label class="form-label small" for="category-@item.GetHashCode()">Category</label>
                                    <select class="form-select form-select-sm mb-2" id="category-@item.GetHashCode()" name="categoryId" required>
                                        <option value="">Select category</option>
                                        @foreach (var category in ViewBag.Categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                    <label class="form-label small" for="price-@item.GetHashCode()">Local price</label>
                                    <input class="form-control form-control-sm mb-2" id="price-@item.GetHashCode()" name="localPrice" type="number" min="0.01" step="0.01" value="@(item.MenuItemPrice?.ToString("0.00") ?? "")" required />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Import food</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Context.Request.Query.ContainsKey("search"))
    {
        <div class="alert alert-warning" role="alert">
            No results found for your search.
        </div>
    }
</div>
