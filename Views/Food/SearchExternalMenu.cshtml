@model IEnumerable<FoodOrderingSystem.Models.DTOs.OpenMenu.OpenMenuItemDto>

@{
    ViewData["Title"] = "Search External Menu";
}

<div class="container mt-4">
    <h1 class="mb-4">Search External Menu (OpenMenu)</h1>

    <form method="get" asp-action="SearchExternalMenu" class="card p-4 shadow-sm mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="search" class="form-label">Search Term</label>
                <input type="text" id="search" name="search" class="form-control" value="@Context.Request.Query["search"]" placeholder="e.g. shrimp" />
            </div>
            <div class="col-md-3">
                <label for="postalCode" class="form-label">Postal Code</label>
                <input type="text" id="postalCode" name="postalCode" class="form-control" value="@Context.Request.Query["postalCode"]" placeholder="e.g. 29204" />
            </div>
            <div class="col-md-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" id="country" name="country" class="form-control" value="@Context.Request.Query["country"]" placeholder="e.g. US" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Menu Item Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Restaurant</th>
                        <th>Cuisine</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.MenuItemName" class="img-thumbnail" style="max-width:100px; height:auto;" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>
                            <td class="fw-bold">@item.MenuItemName</td>
                            <td><small>@item.MenuItemDescription</small></td>
                            <td>
                                @if (item.MenuItemPrice.HasValue)
                                {
                                    <span class="badge bg-success">@item.MenuItemPrice.Value.ToString("C")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Price unavailable</span>
                                }
                            </td>
                            <td>@item.RestaurantName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CuisineTypePrimary))
                                {
                                    <span class="badge bg-info text-dark">@item.CuisineTypePrimary</span>
                                }
                            </td>
                            <td>
                                <small>
                                    @item.Address1<br />
                                    @item.CityTown, @item.StateProvince<br />
                                    @item.Country
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Context.Request.Query.ContainsKey("search"))
    {
        <div class="alert alert-warning" role="alert">
            No results found for your search.
        </div>
    }
</div>
