@model FoodOrderingSystem.Models.Entities.Cart

@{
    ViewData["Title"] = "My Cart";

    decimal total = Model.Items.Sum(
        item => item.Food.Price * item.Quantity);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🛒 My Cart</h1>

        <a asp-controller="Food"
           asp-action="Index"
           class="btn btn-outline-primary">
            Continue Shopping
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Food</th>
                        <th>Price</th>
                        <th style="width: 180px;">Quantity</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        var itemTotal =
                            item.Food.Price * item.Quantity;

                        <tr>

                            <td>
                                <strong>
                                    @item.Food.Name
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @(item.Food.Category?.Name
                                        ?? "Uncategorized")
                                </small>
                            </td>

                            <td>
                                ₹@item.Food.Price
                            </td>

                            <td>

                                <form asp-action="Update"
                                      method="post"
                                      class="d-flex gap-2">

                                    <input type="hidden"
                                           name="foodId"
                                           value="@item.FoodId" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control" />

                                    <button type="submit"
                                            class="btn btn-sm btn-success">
                                        Update
                                    </button>

                                </form>

                            </td>

                            <td>
                                <strong>
                                    ₹@itemTotal
                                </strong>
                            </td>

                            <td>

                                <form asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="foodId"
                                           value="@item.FoodId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Remove
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="card mt-4">

            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <h4>Cart Total</h4>

                    <h4>₹@total</h4>
                </div>

                <a href="#"
                   class="btn btn-primary w-100 mt-3">
                    Proceed to Checkout
                </a>

            </div>

        </div>
    }

</div>