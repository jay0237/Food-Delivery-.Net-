@model FoodOrderingSystem.Models.Entities.Cart

@{
    ViewData["Title"] = "Checkout";
    var total = Model.Items.Sum(item => item.Food.Price * item.Quantity);
    var itemCount = Model.Items.Sum(item => item.Quantity);
}

<section class="checkout-page">
    <header class="checkout-heading">
        <div>
            <p class="checkout-eyebrow">One last look</p>
            <h1>Checkout<span>.</span></h1>
            <p>Review your food and confirm your order when you're ready.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="checkout-back-link">
            <span aria-hidden="true">&larr;</span> Back to cart
        </a>
    </header>

    <nav class="checkout-progress" aria-label="Checkout progress">
        <span class="checkout-progress-done"><b>1</b> Cart</span>
        <i aria-hidden="true"></i>
        <span class="checkout-progress-current"><b>2</b> Review</span>
        <i aria-hidden="true"></i>
        <span class="checkout-progress-next"><b>3</b> Confirmation</span>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (!Model.Items.Any())
    {
        <section class="checkout-empty">
            <div class="checkout-empty-icon" aria-hidden="true">&#128722;</div>
            <h2>Your cart is empty</h2>
            <p>Add a dish from the menu before checking out.</p>
            <a asp-controller="Food" asp-action="Explore" class="checkout-primary-button">Explore the menu</a>
        </section>
    }
    else
    {
        <div class="checkout-layout">
            <section class="checkout-review" aria-labelledby="checkout-items-title">
                <div class="checkout-section-heading">
                    <div>
                        <p class="checkout-eyebrow">Your selection</p>
                        <h2 id="checkout-items-title">Order items</h2>
                    </div>
                    <span class="checkout-item-count">@itemCount @(itemCount == 1 ? "item" : "items")</span>
                </div>

                <div class="checkout-items-list">
                    @foreach (var item in Model.Items)
                    {
                        var itemTotal = item.Food.Price * item.Quantity;
                        var itemName = item.Food.Name.ToLowerInvariant();
                        var categoryName = item.Food.Category?.Name.ToLowerInvariant() ?? string.Empty;
                        var fallbackImage = itemName.Contains("burger") || categoryName.Contains("burger")
                            ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=80"
                            : itemName.Contains("pizza") || categoryName.Contains("pizza")
                                ? "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=300&q=80"
                                : itemName.Contains("fries") || categoryName.Contains("fries")
                                    ? "https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=300&q=80"
                                    : itemName.Contains("drink") || itemName.Contains("shake") || categoryName.Contains("drink")
                                        ? "https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=300&q=80"
                                        : itemName.Contains("bao") || categoryName.Contains("asian")
                                            ? "https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=300&q=80"
                                            : "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=300&q=80";
                        var image = string.IsNullOrWhiteSpace(item.Food.ImageUrl) ? fallbackImage : item.Food.ImageUrl;

                        <article class="checkout-item">
                            <img src="@image"
                                 alt="@item.Food.Name"
                                 class="checkout-item-image"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='@fallbackImage';" />
                            <div class="checkout-item-info">
                                <span class="checkout-item-category">@(item.Food.Category?.Name ?? "Chef's special")</span>
                                <h3>@item.Food.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(item.Food.Description))
                                {
                                    <p>@item.Food.Description</p>
                                }
                                <span class="checkout-item-quantity">Qty: @item.Quantity</span>
                            </div>
                            <strong class="checkout-item-total">₹@itemTotal.ToString("0.00")</strong>
                        </article>
                    }
                </div>

                <a asp-controller="Cart" asp-action="Index" class="checkout-edit-link">
                    Edit your cart <span aria-hidden="true">&rarr;</span>
                </a>
            </section>

            <aside class="checkout-summary" aria-labelledby="checkout-summary-title">
                <p class="checkout-eyebrow">Ready when you are</p>
                <h2 id="checkout-summary-title">Order summary</h2>
                <div class="checkout-summary-line">
                    <span>Items</span>
                    <strong>@itemCount</strong>
                </div>
                <div class="checkout-summary-line checkout-summary-total">
                    <span>Order total</span>
                    <strong>₹@total.ToString("0.00")</strong>
                </div>
                <p class="checkout-summary-note">This total reflects the items currently in your cart.</p>

                <form asp-controller="Order" asp-action="Create" method="post">
                    <button type="submit" class="checkout-primary-button">
                        Confirm order <span aria-hidden="true">&rarr;</span>
                    </button>
                </form>

                <p class="checkout-safe-note"><span aria-hidden="true">&#10003;</span> Your order details are ready for confirmation.</p>
            </aside>
        </div>
    }
</section>
