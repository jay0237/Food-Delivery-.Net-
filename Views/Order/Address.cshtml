@model FoodOrderingSystem.Models.OrderAddressViewModel

@{
    ViewData["Title"] = "Delivery Address";
}

<section class="checkout-page">
    <header class="checkout-heading">
        <div>
            <p class="checkout-eyebrow">Almost there</p>
            <h1>Delivery Details<span>.</span></h1>
            <p>Tell us where to deliver your order.</p>
        </div>
        <a asp-controller="Order" asp-action="Checkout" class="checkout-back-link">
            <span aria-hidden="true">&larr;</span> Back to review
        </a>
    </header>

    <nav class="checkout-progress" aria-label="Checkout progress">
        <span class="checkout-progress-done"><b>1</b> Cart</span>
        <i aria-hidden="true"></i>
        <span class="checkout-progress-done"><b>2</b> Review</span>
        <i aria-hidden="true"></i>
        <span class="checkout-progress-current"><b>3</b> Delivery</span>
        <i aria-hidden="true"></i>
        <span class="checkout-progress-next"><b>4</b> Confirmation</span>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="address-form-container">
        <form asp-controller="Order" asp-action="Create" method="post" class="address-form">
            @Html.AntiForgeryToken()
            
            <div class="address-form-section">
                <h2>Delivery Address</h2>
                
                <div class="form-group">
                    <label asp-for="DeliveryAddress" class="form-label">Street Address *</label>
                    <input asp-for="DeliveryAddress" class="form-control" placeholder="123 Main Street, Apt 4B" />
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="DeliveryCity" class="form-label">City</label>
                        <input asp-for="DeliveryCity" class="form-control" placeholder="Mumbai" />
                        <span asp-validation-for="DeliveryCity" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DeliveryState" class="form-label">State</label>
                        <input asp-for="DeliveryState" class="form-control" placeholder="Maharashtra" />
                        <span asp-validation-for="DeliveryState" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DeliveryZipCode" class="form-label">Zip Code</label>
                        <input asp-for="DeliveryZipCode" class="form-control" placeholder="400001" />
                        <span asp-validation-for="DeliveryZipCode" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="address-form-section">
                <h2>Contact Information</h2>
                
                <div class="form-group">
                    <label asp-for="DeliveryPhone" class="form-label">Phone Number *</label>
                    <input asp-for="DeliveryPhone" class="form-control" placeholder="+91 98765 43210" type="tel" />
                    <span asp-validation-for="DeliveryPhone" class="text-danger"></span>
                    <small class="form-text">We'll call you if we need directions.</small>
                </div>
            </div>

            <div class="address-form-section">
                <h2>Special Instructions</h2>
                
                <div class="form-group">
                    <label asp-for="DeliveryInstructions" class="form-label">Delivery Instructions (Optional)</label>
                    <textarea asp-for="DeliveryInstructions" class="form-control" rows="3" placeholder="Ring the doorbell twice, leave at the door, etc."></textarea>
                    <span asp-validation-for="DeliveryInstructions" class="text-danger"></span>
                </div>
            </div>

            <input type="hidden" asp-for="Latitude" id="latitudeInput" />
            <input type="hidden" asp-for="Longitude" id="longitudeInput" />

            <div class="address-form-actions">
                <button type="button" class="btn btn-outline-primary" id="useDetectedLocation">
                    <span aria-hidden="true">&#9678;</span> Use GPS Coordinates
                </button>
                <button type="submit" class="checkout-primary-button">
                    Place Order <span aria-hidden="true">&rarr;</span>
                </button>
            </div>
        </form>

        <aside class="address-tips">
            <h3>Delivery Tips</h3>
            <ul>
                <li><span aria-hidden="true">✓</span> Make sure your address is complete and accurate</li>
                <li><span aria-hidden="true">✓</span> Include apartment/unit numbers if applicable</li>
                <li><span aria-hidden="true">✓</span> Provide a reachable phone number</li>
                <li><span aria-hidden="true">✓</span> Add any special instructions for the delivery person</li>
            </ul>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .address-form-container {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 2rem;
        max-width: 1200px;
        margin: 2rem auto;
    }
    
    .address-form {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .address-form-section {
        margin-bottom: 2rem;
    }
    
    .address-form-section h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        color: #333;
    }
    
    .form-group {
        margin-bottom: 1rem;
    }
    
    .form-label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
        color: #555;
    }
    
    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 1rem;
    }
    
    .form-control:focus {
        outline: none;
        border-color: var(--primary-color, #007bff);
        box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
    }
    
    .form-row {
        display: grid;
        grid-template-columns: 2fr 2fr 1fr;
        gap: 1rem;
    }
    
    .form-text {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #6c757d;
    }
    
    .address-form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
    }
    
    .address-tips {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        height: fit-content;
        position: sticky;
        top: 2rem;
    }
    
    .address-tips h3 {
        font-size: 1.125rem;
        margin-bottom: 1rem;
        color: #333;
    }
    
    .address-tips ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .address-tips li {
        padding: 0.5rem 0;
        color: #555;
        line-height: 1.5;
    }
    
    .address-tips li span {
        color: #28a745;
        margin-right: 0.5rem;
    }
    
    @@media (max-width: 768px) {
        .address-form-container {
            grid-template-columns: 1fr;
        }
        
        .form-row {
            grid-template-columns: 1fr;
        }
        
        .address-tips {
            position: static;
        }
        
        .address-form-actions {
            flex-direction: column;
        }
    }
</style>
