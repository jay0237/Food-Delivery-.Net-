@{
    ViewData["Title"] = "Sign In";
}

<section class="account-page" aria-labelledby="login-title">
    <aside class="account-story">
        <a class="account-brand" asp-controller="Home" asp-action="Index">
            <span>Smart Bite</span>
            <small>FOOD DELIVERY</small>
        </a>
        <div class="account-story-copy">
            <p class="account-eyebrow">Good food is waiting</p>
            <h1>Come back<br />for another<br /><em>great bite.</em></h1>
            <p>Sign in to pick up where you left off and get your favourites on the way.</p>
        </div>
        <p class="account-story-foot">Freshly made. Happily delivered.</p>
    </aside>

    <div class="account-card">
        <p class="account-eyebrow">Welcome back</p>
        <h2 id="login-title">Sign in</h2>
        <p class="account-intro">Enter your details to continue to Smart Bite.</p>

        <form asp-action="Login" method="post" class="account-form">
            <div asp-validation-summary="All" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label for="email">Email address</label>
                <input id="email"
                       type="email"
                       name="email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email"
                       required />
            </div>

            <div class="account-field">
                <label for="password">Password</label>
                <input id="password"
                       type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="account-submit">Sign in to your account</button>
        </form>

        <p class="account-switch">
            New to Smart Bite?
            <a asp-action="Register">Create an account</a>
        </p>
        <a class="account-home-link" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</section>
