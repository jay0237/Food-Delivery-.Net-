<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Bite</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodOrderingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <div class="brand-group">
                    <a class="navbar-brand smart-brand" asp-controller="Home" asp-action="Index">Smart Bite</a>
                    <span class="brand-caption">FOOD DELIVERY</span>
                </div>
                <button class="location-button" type="button"><span aria-hidden="true">&#9678;</span> Detect Location</button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon">&#9776;</span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Food" asp-action="Index">Menu</a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Cart</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="MyOrders">Order Status</a></li>
                        <li class="nav-item"><a class="nav-link" href="mailto:hello@smartbite.in">Contact <span aria-hidden="true">&#9742;</span></a></li>
                        <li class="nav-item"><a class="sign-in-button" asp-controller="Account" asp-action="Login">Sign In</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <span class="smart-brand">Smart Bite</span> <span>Good food, right where you are.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
