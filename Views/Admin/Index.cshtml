@model IEnumerable<FoodOrderingSystem.Models.DTOs.OpenMenu.OpenMenuItemDto>

@{
    ViewData["Title"] = "Search External Menu";
}

<div class="container mt-4">

    <h1>Search External Menu (OpenMenu)</h1>

    <form method="get" asp-action="SearchExternalMenu">

        <div class="mb-3">
            <label class="form-label">Search Term</label>

            <input
                type="text"
                name="search"
                value="@Context.Request.Query["search"]"
                class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Postal Code</label>

            <input
                type="text"
                name="postalCode"
                value="@Context.Request.Query["postalCode"]"
                class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Country</label>

            <input
                type="text"
                name="country"
                value="@Context.Request.Query["country"]"
                class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Search
        </button>

    </form>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No results found for your search.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                @item.MenuItemName
                            </h4>

                            <p class="card-text">
                                @item.MenuItemDescription
                            </p>

                            <p>
                                <strong>Restaurant:</strong>
                                @item.RestaurantName
                            </p>

                            <p>
                                <strong>Cuisine:</strong>
                                @(item.CuisineTypePrimary ?? "N/A")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.CityTown, @item.StateProvince
                            </p>

                            <p>
                                <strong>Price:</strong>

                                @if (item.MenuItemPrice.HasValue)
                                {
                                    <span>
                                        ₹@item.MenuItemPrice.Value
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Price unavailable
                                    </span>
                                }
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>