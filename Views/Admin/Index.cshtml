@model IEnumerable<FoodOrderingSystem.Models.Entities.Order>

@{
    ViewData["Title"] = "Admin Dashboard";

    var orders = Model.ToList();

    var totalOrders = orders.Count;

    var pendingOrders = orders.Count(o =>
        o.Status == "Pending");

    var preparingOrders = orders.Count(o =>
        o.Status == "Preparing");

    var deliveredOrders = orders.Count(o =>
        o.Status == "Delivered");

    var totalRevenue = orders
        .Where(o => o.Status != "Cancelled")
        .Sum(o => o.TotalAmount);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>📊 Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Manage customer orders and delivery status.
            </p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Dashboard Cards -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Orders
                    </h6>

                    <h2>
                        @totalOrders
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pending
                    </h6>

                    <h2>
                        @pendingOrders
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Preparing
                    </h6>

                    <h2>
                        @preparingOrders
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Revenue
                    </h6>

                    <h2>
                        ₹@totalRevenue
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <!-- Filters -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h5 class="mb-3">
                Filter Orders
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    All
                </a>

                <a asp-action="Index"
                   asp-route-status="Pending"
                   class="btn btn-outline-warning">
                    Pending
                </a>

                <a asp-action="Index"
                   asp-route-status="Confirmed"
                   class="btn btn-outline-primary">
                    Confirmed
                </a>

                <a asp-action="Index"
                   asp-route-status="Preparing"
                   class="btn btn-outline-info">
                    Preparing
                </a>

                <a asp-action="Index"
                   asp-route-status="OutForDelivery"
                   class="btn btn-outline-dark">
                    Out for Delivery
                </a>

                <a asp-action="Index"
                   asp-route-status="Delivered"
                   class="btn btn-outline-success">
                    Delivered
                </a>

                <a asp-action="Index"
                   asp-route-status="Cancelled"
                   class="btn btn-outline-danger">
                    Cancelled
                </a>

            </div>

        </div>

    </div>


    <!-- Orders -->

    @if (!orders.Any())
    {
        <div class="alert alert-info">
            No orders found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Update</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var order in orders)
                    {
                        <tr>

                            <td>
                                <strong>
                                    #@order.Id
                                </strong>
                            </td>

                            <td>
                                @order.User.FullName

                                <br />

                                <small class="text-muted">
                                    @order.User.Email
                                </small>
                            </td>

                            <td>
                                @order.CreatedAt.ToLocalTime()
                            </td>

                            <td>
                                @order.Items.Sum(i => i.Quantity)
                            </td>

                            <td>
                                <strong>
                                    ₹@order.TotalAmount
                                </strong>
                            </td>

                            <td>

                                @if (order.Status == "Delivered")
                                {
                                    <span class="badge bg-success">
                                        Delivered
                                    </span>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @order.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <form asp-action="UpdateOrderStatus"
                                      method="post">

                                    <input type="hidden"
                                           name="orderId"
                                           value="@order.Id" />

                                    <select name="status"
                                            class="form-select form-select-sm mb-2">

                                        <option value="Pending"
                                            selected="@(order.Status == "Pending")">
                                            Pending
                                        </option>

                                        <option value="Confirmed"
                                            selected="@(order.Status == "Confirmed")">
                                            Confirmed
                                        </option>

                                        <option value="Preparing"
                                            selected="@(order.Status == "Preparing")">
                                            Preparing
                                        </option>

                                        <option value="OutForDelivery"
                                            selected="@(order.Status == "OutForDelivery")">
                                            Out for Delivery
                                        </option>

                                        <option value="Delivered"
                                            selected="@(order.Status == "Delivered")">
                                            Delivered
                                        </option>

                                        <option value="Cancelled"
                                            selected="@(order.Status == "Cancelled")">
                                            Cancelled
                                        </option>

                                    </select>

                                    <button type="submit"
                                            class="btn btn-sm btn-primary w-100">
                                        Update
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>