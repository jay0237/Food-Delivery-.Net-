@model IEnumerable<FoodOrderingSystem.Models.Entities.Order>

@{
    ViewData["Title"] = "Admin Dashboard";
    var statuses = new[] { "Pending", "Confirmed", "Preparing", "OutForDelivery", "Delivered", "Cancelled" };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Admin Dashboard</h1>
        <div>
            <a asp-controller="Food" asp-action="SearchExternalMenu" class="btn btn-primary me-2">Import from OpenMenu</a>
            <a asp-controller="Food" asp-action="Index" class="btn btn-outline-secondary">Manage food</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h2 class="h4">Orders</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info">No orders have been placed yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Placed</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@(order.User?.FullName ?? order.User?.Email ?? "Unknown")</td>
                            <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td><span class="badge bg-secondary">@order.Status</span></td>
                            <td>
                                <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <select name="status" class="form-select form-select-sm">
                                        @foreach (var status in statuses)
                                        {
                                            if (order.Status == status)
                                            {
                                                <option value="@status" selected>@status</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>